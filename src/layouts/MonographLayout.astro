---
import { SITE_ORIGIN } from "../config";
import type { MonographDocument } from "../data/cv";
import "../styles/monograph.css";

interface Props {
  doc: MonographDocument;
}

const { doc } = Astro.props;
const canonicalUrl = `${SITE_ORIGIN}${doc.meta.canonicalPath}`;
const trUrl = `${SITE_ORIGIN}/`;
const enUrl = `${SITE_ORIGIN}/en/`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_ORIGIN}/#person`,
  name: doc.identity.fullName,
  alternateName: "fusuyfusuy",
  url: SITE_ORIGIN,
  email: "mailto:yusufakcakaya@gmail.com",
  jobTitle: doc.identity.role,
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: "Boğaziçi University",
    department: "Department of Management Information Systems",
    url: "https://mis.bogazici.edu.tr/",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Boğaziçi University",
      url: "https://bogazici.edu.tr/",
    },
  ],
  knowsAbout: [
    "Cybersecurity",
    "Artificial Intelligence",
    "Risk Management",
    "IT Governance",
    "Information Architecture",
    "Agent-Based Modeling",
    "Python",
    "TypeScript",
    "Rust",
  ],
  sameAs: [
    "https://github.com/fusuyfusuy",
    "https://linkedin.com/in/yusufakcakaya/",
    "https://daginikmasa.com/",
    "https://fusuycorp.com/",
  ],
};
---

<!doctype html>
<html lang={doc.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{doc.meta.title}</title>
    <meta name="description" content={doc.meta.description} />
    <meta name="author" content={doc.identity.fullName} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={trUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={doc.meta.title} />
    <meta property="og:description" content={doc.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={doc.langTag.replace("-", "_")} />
    <meta property="og:site_name" content={doc.identity.fullName} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={doc.meta.title} />
    <meta name="twitter:description" content={doc.meta.description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
  </head>
  <body data-active-ecosystem="academic">
    <slot />
  </body>
</html>
